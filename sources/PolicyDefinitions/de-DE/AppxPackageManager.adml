        <checkBox refId="Todo" defaultChecked="false">Microsoft To Do</checkBox>
        <checkBox refId="BingWeather" defaultChecked="true">MSN Wetter</checkBox>
        <checkBox refId="OutlookForWindows" defaultChecked="false">Outlook für Windows</checkBox>
        <checkBox refId="Paint" defaultChecked="false">Paint</checkBox>
        <checkBox refId="QuickAssist" defaultChecked="false">Schnellhilfe</checkBox>
        <checkBox refId="ScreenSketch" defaultChecked="false">Snipping Tool</checkBox>
        <checkBox refId="WindowsCalculator" defaultChecked="false">Windows-Rechner</checkBox>
        <checkBox refId="WindowsCamera" defaultChecked="false">Windows-Kamera **</checkBox>
        <checkBox refId="MediaPlayer" defaultChecked="false">Windows Medienwiedergabe **</checkBox>
        <checkBox refId="WindowsNotepad" defaultChecked="false">Windows-Editor **</checkBox>
        <checkBox refId="WindowsSoundRecorder" defaultChecked="false">Windows-Audiorekorder</checkBox>
        <checkBox refId="WindowsTerminal" defaultChecked="false">Windows-Terminal</checkBox>
        <checkBox refId="GamingApp" defaultChecked="true">Xbox Gaming-App</checkBox>
        <checkBox refId="XboxIdentityProvider" defaultChecked="true">Xbox Identity Provider *</checkBox>
