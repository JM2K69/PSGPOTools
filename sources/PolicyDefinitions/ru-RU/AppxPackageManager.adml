        <dropdownList refId="LocalMachine" noSort="true" defaultItem="1">Локальный компьютер</dropdownList>
        <dropdownList refId="Intranet" noSort="true" defaultItem="1">Интрасеть</dropdownList>
        <dropdownList refId="TrustedSites" noSort="true" defaultItem="1">Надежные сайты</dropdownList>
        <dropdownList refId="Internet" noSort="true" defaultItem="1">Интернет</dropdownList>
        <dropdownList refId="UntrustedSites" noSort="true" defaultItem="0">Ненадежные сайты</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
