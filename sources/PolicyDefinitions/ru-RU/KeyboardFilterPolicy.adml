<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Групповая политика для фильтра клавиатуры</displayName>
  <description>Параметры групповой политики для фильтра клавиатуры</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Фильтр клавиатуры</string>
      <string id="AllowKbFilterInRemoteSessions">Разрешить фильтрацию клавиатуры в удаленных сеансах</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Фильтр клавиатуры обычно применяется только к локальным сеансам.
      
Включение этого параметра позволит применять фильтр клавиатуры к пользователям, подключаться к компьютеру с помощью удаленных сеансов.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
