        <dropdownList refId="TrustedSites" noSort="true" defaultItem="1">Důvěryhodné servery</dropdownList>
        <dropdownList refId="Internet" noSort="true" defaultItem="1">Internet</dropdownList>
        <dropdownList refId="UntrustedSites" noSort="true" defaultItem="0">Nedůvěryhodné weby</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
