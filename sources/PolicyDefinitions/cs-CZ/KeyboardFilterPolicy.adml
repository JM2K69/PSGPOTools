<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Zásady skupiny Filtr klávesnice</displayName>
  <description>Nastavení zásad skupiny pro filtr klávesnice</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Filtr klávesnice</string>
      <string id="AllowKbFilterInRemoteSessions">Povolit filtr klávesnice ve vzdálených relacích</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Filtr klávesnice se obvykle vztahuje pouze na místní relace.
      
Povolením tohoto nastavení povolíte použití filtru klávesnice pro uživatele, které se k počítači připojují pomocí vzdálených relací.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
