    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Protokolování událostí</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Trasování</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>Trasování uživatele</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>Trasování počítače</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Trasování plánování</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">Maximální velikost souboru trasování (kB)</decimalTextBox>
      </presentation>
