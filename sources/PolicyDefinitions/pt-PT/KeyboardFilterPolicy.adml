<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Política de grupo de Filtro de Teclado</displayName>
  <description>Definições de política de grupo para Filtro de Teclado</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Filtro de Teclado</string>
      <string id="AllowKbFilterInRemoteSessions">Permitir Filtro de Teclado em sessões remotas</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Normalmente, o filtro de teclado aplica-se apenas a sessões locais.
      
Ativar esta definição permitirá que o filtro de teclado seja aplicado aos utilizadores que se ligam ao computador através de sessões remotas.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
