      <presentation id="SetCopilotHardwareKey">
        <textBox refId="SetCopilotHardwareKey_Name">
          <label>Entrar no AUMID da Aplicação</label>
          <defaultValue>
          </defaultValue>
        </textBox>
      </presentation>
