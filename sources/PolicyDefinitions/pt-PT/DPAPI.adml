<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>DPAPI</displayName>
  <description>Configurar definições do DPAPI</description>
  <resources>
    <stringTable>
      <string id="DPAPI">DPAPI</string>
      <string id="DomainBackupKeyRotationPeriod">Definir o período de rotação das chaves de cópia de segurança do DPAPI</string>
      <string id="DomainBackupKeyRotationPeriod_Explain">Esta definição de política especifica o período de rotação das chaves de cópia de segurança DPAPI. 
Pode utilizar esta definição para substituir o valor predefinido de 90 dias. Defina 0 para desativar a rotação das chaves de cópia de segurança DPAPI. 
Se ativar esta definição de política, defina o número de dias que o sistema aguarda antes de gerar uma nova chave de cópia de segurança DPAPI. 
Se desativar ou não configurar esta definição de política, é utilizado o valor predefinido de 90 dias.</string>
    </stringTable>
    <presentationTable>
      <presentation id="DPAPI_DomainBackupKeyRotationPeriod_Presentation">
        <decimalTextBox refId="DPAPI_DomainBackupKeyRotationPeriod_Prompt" defaultValue="90">Especifique o período de rotação das chaves de cópia de segurança DPAPI em dias. 
Defina 0 para desativar a rotação das chaves de cópia de segurança DPAPI.</decimalTextBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
