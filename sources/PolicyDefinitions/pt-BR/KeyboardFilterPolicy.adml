<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Política de grupo do Filtro de Teclado</displayName>
  <description>Configurações de política de grupo para o Filtro de Teclado</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Filtro de Teclado</string>
      <string id="AllowKbFilterInRemoteSessions">Permitir o Filtro de Teclado em sessões remotas</string>
      <string id="AllowKbFilterInRemoteSessions_Text">O filtro de teclado normalmente se aplica somente a sessões locais.
      
Habilitar essa configuração permitirá que o filtro de teclado seja aplicado aos usuários que se conectam ao computador por sessões remotas.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
