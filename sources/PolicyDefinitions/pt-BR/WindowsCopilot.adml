      <presentation id="SetCopilotHardwareKey">
        <textBox refId="SetCopilotHardwareKey_Name">
          <label>Introduzir AUMID do Aplicativo</label>
          <defaultValue>
          </defaultValue>
        </textBox>
      </presentation>
