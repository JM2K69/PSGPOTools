          <label>Insira a lista de negação de URIs :</label>
        </textBox>
      </presentation>
      <presentation id="SetDataLossPreventionProvider">
        <textBox refId="SetDataLossPreventionProvider_Name">
          <label>Insira o ID do provedor de DLP:</label>
        </textBox>
      </presentation>
