  <displayName>Gruppepolitik for tastaturfilter</displayName>
  <description>Gruppepolitikindstillinger for tastaturfilter</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Tastaturfilter</string>
      <string id="AllowKbFilterInRemoteSessions">Tillad tastaturfilter i fjernsessioner</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Tastaturfilteret gælder typisk kun for lokale sessioner.
      
Hvis du aktiverer denne indstilling, kan tastaturfilteret anvendes på brugere, der opretter forbindelse til computeren via fjernsessioner.</string>
    </stringTable>
