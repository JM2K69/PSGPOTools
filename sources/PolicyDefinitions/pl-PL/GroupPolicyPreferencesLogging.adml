      <string id="CSE_TRACEFILEPATHUSER">Dane śledzenia użytkownika</string>
      <string id="CSE_TRACEFILEPATHMACHINE">Dane śledzenia komputera</string>
      <string id="CSE_TRACEFILEPATH">Plik śledzenia</string>
      <string id="CSE_TRACEFILEPATHPLANNING">Dane śledzenia planowania</string>
      <string id="CSE_TRACEFILEMAXSIZE">Maksymalny rozmiar pliku śledzenia (KB)</string>
      <string id="CSE_TRACELEVELNORMAL">Wyłączony</string>
      <string id="CSE_TRACELEVELVERBOSE">Włączony</string>
      <string id="CSE_BACKGROUNDPRIORTYLEVEL">Priorytet w tle</string>
      <string id="CSE_PRILEVEL_NORMAL">Normalny</string>
      <string id="CSE_PRILEVEL_BELOWNORMAL">Poniżej normalnego</string>
      <string id="CSE_PRILEVEL_LOWEST">Najniższy</string>
      <string id="CSE_PRILEVEL_IDLE">Bezczynny</string>
      <string id="CSE_LOGLEVEL">Rejestrowanie zdarzeń</string>
      <string id="CSE_LOGLEVEL_INFORMATION">Informacje, ostrzeżenia i błędy</string>
      <string id="CSE_LOGLEVEL_WARNINGS">Ostrzeżenia i błędy</string>
