    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Rejestrowanie zdarzeń</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Śledzenie</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>Dane śledzenia użytkownika</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>Dane śledzenia komputera</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Dane śledzenia planowania</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">Maksymalny rozmiar pliku śledzenia (KB)</decimalTextBox>
      </presentation>
      <presentation id="CSE_DataSources_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Rejestrowanie zdarzeń</dropdownList>
