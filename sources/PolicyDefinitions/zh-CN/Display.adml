<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>请在此处输入显示名称</displayName>
  <description>请在此处输入描述</description>
  <resources>
    <stringTable>
      <string id="DisplayCat">显示</string>
      <string id="Display_TurnOnGdiDPIScaling_Help">GDI DPI 缩放可以使非 DPI 感知的应用程序变成针对每个监视器感知 DPI。

此策略设置允许你为旧版应用程序启用 GDI DPI 缩放。

如果启用此策略设置，列表中的所有旧版应用程序都将启用 GDI DPI 缩放。

如果禁用或未配置此策略设置，除了使用 ApplicationCompatibility 数据库、ApplicationCompatibility UI 系统(增强)设置或应用程序清单启用 GDI DPI 缩放的应用程序之外，其他应用程序均不会启用 GDI DPI 缩放。

如果某一应用程序的 GDI DPI 缩放策略设置既设为启用又设为禁用，则会禁用 GDI DPI 缩放。</string>

<string id="Display_ConfigureMultipleDisplayModeHelp">启用此策略可替代连接其他显示器时的默认行为。它允许控制显示器是自动克隆(镜像)主屏幕还是扩展桌面。
扩展会将显示器展开到第二台显示器上，以便在每个屏幕上具有不同的内容。克隆将主显示器复制到第二个显示器上，同时在两个屏幕上显示相同的内容。内部默认使用由 Windows 设置确定的系统的默认行为。</string>
<string id="DisplayConfigureMultipleDisplayMode"> 配置多显示器模式</string>

<string id="Display_SetClonePreferredResolutionSourceHelp">启用此策略可替代连接其他显示器时的默认行为。它允许控制克隆显示器是优先使用内部显示器还是外部显示器，即设置其首选分辨率源。
内部设置将主显示器的分辨率作为两个屏幕的信号源。外部设置将所连接(外部)显示器的分辨率设置为两个屏幕上的信号源。默认使用由 Windows 设置确定的系统的默认行为。</string>
<string id="DisplaySetClonePreferredResolutionSource"> 设置克隆的显示器首选解析源</string>

<string id="Display_TurnOffGdiDPIScaling_Help">GDI DPI 缩放可以使非 DPI 感知的应用程序变成针对每个监视器感知 DPI。

此策略设置允许你禁用旧版应用程序的 GDI DPI 缩放。

如果启用此策略设置，将对列表中的所有旧版应用程序禁用 GDI DPI 缩放，即使它们已使用 ApplicationCompatibility 数据库、ApplicationCompatibility UI 系统(增强)设置或应用程序清单启用了 GDI DPI 缩放。

如果禁用或未配置此策略设置，旧版应用程序可能还会启用 GDI DPI 缩放。

如果某一应用程序的 GDI DPI 缩放策略设置既设为启用又设为禁用，则会禁用 GDI DPI 缩放。</string>
      <string id="DisplayTurnOnGdiDPIScaling">为应用程序启用 GdiDPIScaling</string>
      <string id="DisplayTurnOffGdiDPIScaling">为应用程序关闭 GdiDPIScaling</string>
      <string id="DisplayPerProcessSystemDpiSettingsHelp">每进程系统 DPI 是桌面应用程序的应用程序兼容性功能，在显示比例系数(DPI)更改后无法正确呈现。当主显示器的显示比例系数发生更改时(例如，连接或断开具有不同显示比例系数(DPI)的显示器、从具有不同显示比例系数的设备进行远程连接，或者手动更改显示比例系数)，许多桌面应用程序可能会显示模糊。在这种情况下，尚未更新以正确显示的桌面应用程序将变得模糊，直到用户注销并重新登录到 Windows 为止。

启用此策略时，某些显示模糊的应用程序在重启后画面会变得清晰，而无需用户注销并返回 Windows。

请注意以下事项:

每进程系统 DPI 将仅改进位于主显示器上的桌面应用程序的呈现。某些桌面应用程序在具有不同显示比例系数的辅助显示器上仍可能模糊。

每进程系统 DPI 不适用于所有应用程序，因为某些较旧的桌面应用程序在高 DPI 显示器上始终模糊。

在某些情况下，你可能会在某些桌面应用程序中看到一些奇怪的行为。如果发生这种情况，则应禁用每进程系统 DPI。

启用此设置后，可以指定桌面应用程序的系统范围默认设置以及每个应用程序的覆盖。如果禁用或未配置此设置，则每进程系统 DPI 不会应用于系统上的任何进程。

</string>
      <string id="DisplayPerProcessSystemDpiSettings">配置每进程系统 DPI 设置</string>
      <string id="DisplayGlobalPerProcessSystemDpiEnable">启用</string>
      <string id="DisplayGlobalPerProcessSystemDpiDisable">禁用</string>
      <string id="DisplayConfigureMultipleDisplayModeClone">克隆</string>
      <string id="DisplayConfigureMultipleDisplayModeDefault">默认</string>
      <string id="DisplayConfigureMultipleDisplayModeExtend">扩展</string>
      <string id="DisplayConfigureMultipleDisplayInternalOnly">仅内部</string>
      <string id="DisplayConfigureMultipleDisplayExternalOnly">仅外部</string>
      <string id="DisplaySetClonePreferredResolutionSourceDefault">默认</string>
      <string id="DisplaySetClonePreferredResolutionSourceInternal">内部</string>
      <string id="DisplaySetClonePreferredResolutionSourceExternal">外部</string>
      <string id="DisplayEnablePerProcessSystemDpiSettings">针对应用程序启用每进程系统 DPI</string>
      <string id="DisplayDisablePerProcessSystemDpiSettings">针对应用程序禁用每进程系统 DPI</string>
    </stringTable>
    <presentationTable>
      <presentation id="DisplayTurnOnGdiDPIScaling">
        <textBox refId="DisplayTurnOnGdiDPIScalingPrompt">
          <label>启用以下应用程序的 GDI DPI 缩放。使用应用程序完整路径或应用程序文件名和扩展名。用分号分隔应用程序。</label>
        </textBox>
      </presentation>
      <presentation id="DisplayTurnOffGdiDPIScaling">
        <textBox refId="DisplayTurnOffGdiDPIScalingPrompt">
          <label>禁用以下应用程序的 GDI DPI 缩放。使用应用程序完整路径或应用程序文件名和扩展名。用分号分隔应用程序。</label>
        </textBox>
      </presentation>
      <presentation id="DisplayPerProcessSystemDpiSettings">
        <dropdownList refId="DisplayGlobalPerProcessSystemDpiSettings" noSort="true" defaultItem="0">针对所有应用程序启用或禁用每进程系统 DPI。</dropdownList>
        <textBox refId="DisplayEnablePerProcessSystemDpiSettings">
          <label>针对以下应用程序启用每进程系统 DPI。使用应用程序完整路径或应用程序文件名和扩展名。用分号分隔应用程序。</label>
        </textBox>
        <textBox refId="DisplayDisablePerProcessSystemDpiSettings">
          <label>针对以下应用程序禁用每进程系统 DPI。使用应用程序完整路径或应用程序文件名和扩展名。用分号分隔应用程序。</label>
        </textBox>
      </presentation>
      <presentation id="DisplayConfigureMultipleDisplayMode">
        <dropdownList refId="DisplayConfigureMultipleDisplayModeSettings" noSort="true" defaultItem="0">使用默认 Windows 设置作为多显示模式的配置克隆、扩展、InternalOnly、ExternalOnly 或继续。</dropdownList>
      </presentation>
      <presentation id="DisplaySetClonePreferredResolutionSource">
        <dropdownList refId="DisplaySetClonePreferredResolutionSourceSettings" noSort="true" defaultItem="0">将 Windows 用于新克隆显示器的默认分辨率设置为内部、外部或默认 Windows 设置。</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
