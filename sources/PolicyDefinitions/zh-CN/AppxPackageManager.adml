        <checkBox refId="WindowsCamera" defaultChecked="false">Windows 相机 **</checkBox>
        <checkBox refId="MediaPlayer" defaultChecked="false">Windows 媒体播放器 **</checkBox>
        <checkBox refId="WindowsNotepad" defaultChecked="false">Windows 记事本 **</checkBox>
        <checkBox refId="WindowsSoundRecorder" defaultChecked="false">Windows 录音机</checkBox>
        <checkBox refId="WindowsTerminal" defaultChecked="false">Windows 终端</checkBox>
