  <displayName>键盘筛选器组策略</displayName>
  <description>键盘筛选器的组策略设置</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">键盘筛选器</string>
      <string id="AllowKbFilterInRemoteSessions">允许在远程会话中使用键盘筛选器</string>
      <string id="AllowKbFilterInRemoteSessions_Text">键盘筛选器通常仅适用于本地会话。
      
启用此设置将允许通过远程会话将键盘筛选器应用到连接到计算机的用户。</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
