<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ReFS 组策略</displayName>
  <description>ReFS 的组策略设置</description>
  <resources>
    <stringTable>
      <string id="ReFS">ReFS</string>
      <string id="EnableDevDrive">启用开发人员驱动器</string>
      <string id="EnableDevDriveText">开发人员驱动器或开发人员卷是针对开发人员方案的性能进行优化的卷。开发人员卷允许管理员选择附加在卷上的文件系统筛选器。

禁用此设置将禁止创建新的开发人员卷，现有开发人员卷将作为常规卷装载。

如果未配置此设置，则默认策略是启用开发人员卷，同时允许防病毒筛选器附加到 Deveveloper 卷上。 此外，如果未配置，本地管理员可以选择不将防病毒筛选器附加到开发人员卷。

需要重新启动才能使此设置生效。</string>
      <string id="ModeOff">关</string>
      <string id="ModeAudit">仅审核</string>
      <string id="ModeBlock">阻止</string>
      <string id="BlockExternalBusMount">控制在 USB 和 IEEE 1394 磁盘上装载 ReFS 卷</string>
      <string id="BlockExternalBusMountText">控制是否允许 ReFS 卷装载到通过 USB 或 IEEE 1394 连接的磁盘上。不支持在热插拔或可移动磁盘上使用 ReFS 配置。

“阻止”拒绝装载，并在系统日志中记录事件。

“仅审核”允许装载并记录相同事件，因此可以在强制实施此策略之前评估启用其效果。

“关”不执行任何审核和阻止。

对于存储空间卷，检查适用于支持池的物理磁盘，而不是空间本身。

如果未配置此策略设置，则使用此计算机上的本地设置。如果不存在本地设置，则使用此版本 Windows 的默认行为。

ReFS 在加载时读取此设置，因此需要重启才能应用更改。然后，每次装载卷时都会评估该设置，因此已装载的卷会保持当前状态，直到它被卸载并再次装载。</string>
      <string id="BlockHotplugMount">控制在热插拔磁盘上装载 ReFS 卷</string>
      <string id="BlockHotplugMountText">控制是否允许 ReFS 卷装载到存储堆栈报告为热插拔的磁盘上，无论它们通过何种总线连接。不支持在热插拔或可移动磁盘上使用 ReFS 配置。

“阻止”拒绝装载，并在系统日志中记录事件。

“仅审核”允许装载并记录相同事件，因此可以在强制实施此策略之前评估启用其效果。

“关”不执行任何审核和阻止。

对于存储空间卷，检查适用于支持池的物理磁盘，而不是空间本身。

如果未配置此策略设置，则使用此计算机上的本地设置。如果不存在本地设置，则使用此版本 Windows 的默认行为。

ReFS 在加载时读取此设置，因此需要重启才能应用更改。然后，每次装载卷时都会评估该设置，因此已装载的卷会保持当前状态，直到它被卸载并再次装载。</string>
    </stringTable>

    <presentationTable>
      <presentation id="EnableDevDriveOptions">
        <checkBox refId="DevDriveAllowAntivirusFilter" defaultChecked="true">允许防病毒筛选器保护开发人员驱动器</checkBox>
      </presentation>
      <presentation id="BlockExternalBusMountOptions">
        <dropdownList refId="BlockExternalBusMountMode" defaultItem="0">针对 USB 或 IEEE 1394 磁盘上的 ReFS 卷的操作</dropdownList>
      </presentation>
      <presentation id="BlockHotplugMountOptions">
        <dropdownList refId="BlockHotplugMountMode" defaultItem="0">对热插拔磁盘上的 ReFS 卷的操作</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
