<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Stratégie de groupe de filtre clavier</displayName>
  <description>Paramètres de stratégie de groupe pour le filtre clavier</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Filtre clavier</string>
      <string id="AllowKbFilterInRemoteSessions">Autoriser le filtre clavier lors de sessions à distance</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Le filtre clavier s’applique généralement uniquement aux sessions locales.
      
L’activation de ce paramètre permet d’appliquer le filtre clavier aux utilisateurs qui se connectent à l’ordinateur par sessions à distance.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
