          <label>Lijst met geweigerde URI's invoeren:</label>
        </textBox>
      </presentation>
      <presentation id="SetDataLossPreventionProvider">
        <textBox refId="SetDataLossPreventionProvider_Name">
          <label>Voer de DLP-provider ID in:</label>
