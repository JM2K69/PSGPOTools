<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0">
  <displayName>Delivery Optimization-groepsbeleid</displayName>
  <description>In dit bestand worden de groepsbeleidsinstellingen voor Delivery Optimization beschreven</description>
  <resources>
    <stringTable>
      <string id="DeliveryOptimizationCat">Delivery Optimization</string>
      <string id="DownloadMode">Downloadmodus</string>
      <string id="DownloadMode_Help">Hiermee geeft u de methode op die Delivery Optimization kan gebruiken om inhoud te downloaden namens verschillende Microsoft-producten.

0 = alleen HTTP, geen peering
1 = HTTP gemengd met peering achter dezelfde NAT
2 = HTTP gemengd met peering in een privégroep
3 = HTTP gemengd met internetpeering
99 = alleen HTTP, geen peering, geen gebruik van DO-cloudservice
100 = Bypass-modus, afgeschaft in Windows 11</string>
      <string id="DownloadMode_CdnOnly">Alleen HTTP (0)</string>
      <string id="DownloadMode_Lan">LAN (1)</string>
      <string id="DownloadMode_Group">Groep (2)</string>
      <string id="DownloadMode_Internet">Internet (3)</string>
      <string id="DownloadMode_Simple">Eenvoudig (99)</string>
      <string id="DownloadMode_Bypass">Bypass (100)</string>
      <string id="GroupId">Groeps-id</string>
      <string id="GroupId_Help">Hiermee geeft u een willekeurige groeps-id op waartoe het apparaat behoort. Er moet een GUID worden gebruikt.</string>
      <string id="MaxCacheSize">Maximale cachegrootte (percentage)</string>
      <string id="MaxCacheSize_Help">Hiermee geeft u de maximale cachegrootte op die Delivery Optimization kunt gebruiken als percentage van de beschikbare schijfruimte.</string>
      <string id="AbsoluteMaxCacheSize">Absolute maximale cachegrootte (in GB)</string>
      <string id="AbsoluteMaxCacheSize_Help">Hiermee geeft u de maximale grootte in GB van Delivery Optimization cache op. Dit beleid overschrijft het MaxCacheSize-beleid.</string>
      <string id="MaxCacheAge">Maximale cacheleeftijd (in seconden)</string>
      <string id="MaxCacheAge_Help">Hiermee geeft u de maximale tijd in seconden op dat elk bestand in de Delivery Optimization cache wordt bewaard nadat het is gedownload.</string>
      <string id="MonthlyUploadDataCap">Maandelijkse gegevenslimiet voor uploaden (in GB)</string>
      <string id="MonthlyUploadDataCap_Help">Hiermee geeft u het maximum aantal bytes in GB op dat Delivery Optimization in elke kalendermaand mag uploaden naar internetpeers.</string>
      <string id="MinBackgroundQos">Minimumachtergrond QoS (in kB/s)</string>
      <string id="MinBackgroundQos_Help">Hiermee geeft u de minimale download-QoS (Quality of Service) op in kilobytes per seconde voor downloads op de achtergrond.</string>
      <string id="ModifyCacheDrive">Cachestation aanpassen</string>
      <string id="ModifyCacheDrive_Help">Geeft het station aan dat Delivery Optimization moet gebruiken voor de cache. De stationslocatie kan worden opgegeven met omgevingsvariabelen, stationsletters of een volledig pad.</string>
      <string id="MaxBackgroundDownloadBandwidth">Maximale bandbreedte voor downloaden op achtergrond (in kB/s)</string>
      <string id="MaxBackgroundDownloadBandwidth_Help">Hiermee geeft u de maximale bandbreedte voor downloaden op de achtergrond op in kiloBytes per seconde die het apparaat kan gebruiken voor alle gelijktijdige downloadactiviteiten met behulp van Delivery Optimization.</string>
      <string id="MaxForegroundDownloadBandwidth">Maximale bandbreedte voor downloaden op de voorgrond (in kB/s)</string>
      <string id="MaxForegroundDownloadBandwidth_Help">Hiermee geeft u de maximale bandbreedte voor downloaden op de voorgrond op in kiloBytes per seconde die het apparaat kan gebruiken voor alle gelijktijdige downloadactiviteiten met behulp van Delivery Optimization.</string>
      <string id="PercentageMaxBackgroundBandwidth">Maximale bandbreedte voor downloaden op achtergrond (percentage)</string>
      <string id="PercentageMaxBackgroundBandwidth_Help">Hiermee geeft u de maximale bandbreedte voor downloaden op de achtergrond op die Delivery Optimization gebruikt voor alle gelijktijdige downloadactiviteiten als percentage van de beschikbare downloadbandbreedte.</string>
      <string id="PercentageMaxForegroundBandwidth">Maximale bandbreedte voor downloaden op voorgrond (percentage)</string>
      <string id="PercentageMaxForegroundBandwidth_Help">Hiermee geeft u de maximale bandbreedte voor downloaden op de voorgrond op die Delivery Optimization gebruikt voor alle gelijktijdige downloadactiviteiten als percentage van de beschikbare downloadbandbreedte.</string>
      <string id="MinFileSizeToCache">Minimale bestandsgrootte voor inhoud van P2P-caching (in MB)</string>
      <string id="MinFileSizeToCache_Help">Hiermee geef je de minimale bestandsgrootte voor inhoud op in MB die in aanmerking komt voor gebruik van P2P.</string>
      <string id="AllowVPNPeerCaching">P2P inschakelen terwijl het apparaat verbinding maakt via VPN</string>
      <string id="AllowVPNPeerCaching_Help">Hiermee geeft u op of het apparaat met een actieve VPN-verbinding wel of niet mag deelnemen aan P2P.</string>
      <string id="MinRAMAllowedToPeer">Minimaal vereiste RAM-capaciteit (inclusief) voor gebruik van P2P-caching (in GB)</string>
      <string id="MinRAMAllowedToPeer_Help">Hiermee geef je de minimale totale RAM-grootte in GB op die is vereist voor het gebruik van P2P.</string>
      <string id="MinDiskSizeAllowedToPeer">Minimale schijfgrootte die P2P mag gebruiken (in GB)</string>
      <string id="MinDiskSizeAllowedToPeer_Help">Hiermee geeft u de vereiste minimale totale schijfgrootte in GB op voor het apparaat om P2P te gebruiken.</string>
      <string id="MinBatteryPercentageAllowedToUpload">Uploads toestaan terwijl het apparaat alleen op de batterij loopt terwijl er een batterijniveau (percentage) is ingesteld</string>
      <string id="MinBatteryPercentageAllowedToUpload_Help">Hiermee geeft u het minimale batterijniveau op dat is vereist voor uploaden naar peers bij gebruik van batterijstroom.</string>
      <string id="CacheHost">Hostnaam van cacheserver</string>
      <string id="CacheHost_Help">Hiermee geeft u een of meer Microsoft Verbonden cache-servers op die door uw client(s) worden gebruikt. Een of meer waarden kunnen worden toegevoegd als Fully Qualified Domain Names (FQDN) of IP-adressen. Als u meerdere waarden wilt toevoegen, scheidt u elk FQDN- of IP-adres door komma's.</string>
      <string id="CacheHostSource">Bron van hostnaam cacheserver</string>
      <string id="CacheHostSource_Help">Hiermee geeft u op hoe uw client(s) Microsoft Verbonden cache-servers dynamisch kunnen detecteren.

1 = DHCP-optie 235
2 = DHCP-optie 235 forceren</string>
      <string id="CacheHostSource_DHCP">DHCP-optie 235</string>
      <string id="CacheHostSource_DHCP_Force">DHCP-optie 235 forceren</string>
      <string id="DisallowCacheServerDownloadsOnVPN">Downloads van met Microsoft verbonden cache-servers niet toestaan wanneer het apparaat verbinding maakt via VPN</string>
      <string id="DisallowCacheServerDownloadsOnVPN_Help">Geef op dat downloads van Microsoft Verbonden cache-servers niet mogen worden gedownload wanneer het apparaat verbinding maakt via VPN. Als deze optie is uitgeschakeld, mag het apparaat downloaden van Microsoft Verbonden cache wanneer er verbinding is via VPN. Schakel het selectievakje in om deze downloads te blokkeren.</string>
      <string id="GroupIdSource">Selecteer de bron van groeps-id's</string>
      <string id="GroupIdSource_Help">Hiermee geeft u de bron van de groeps-id op die wordt gebruikt voor peerselectie.

0 = Niet ingesteld
1 = AD-site
2 = Geverifieerde domein-SID
3 = DHCP-optie-id
4 = DNS-achtervoegsel
5 = Tenant-id entra-id</string>
      <string id="GroupIdSource_Unset">Niet ingesteld (0)</string>
      <string id="GroupIdSource_AD">AD-site (1)</string>
      <string id="GroupIdSource_SID">Geverifieerde domein-SID (2)</string>
      <string id="GroupIdSource_DHCP">DHCP-optie-id (3)</string>
      <string id="GroupIdSource_DNS">DNS-achtervoegsel (4)</string>
      <string id="GroupIdSource_AAD">AAD-tenant-ID (5)</string>
      <string id="DelayBackgroundDownloadFromHttp">Download op de achtergrond via HTTP vertragen (in seconden)</string>
      <string id="DelayBackgroundDownloadFromHttp_Help">Voor downloads op de achtergrond die P2P gebruiken, geeft u de wachttijd op voordat het downloaden van de HTTP-bron wordt gestart.</string>
      <string id="DelayForegroundDownloadFromHttp">Download op de voorgrond via HTTP vertragen (in seconden)</string>
      <string id="DelayForegroundDownloadFromHttp_Help">Voor downloads op de voorgrond die P2P gebruiken, geeft u de wachttijd op voordat het downloaden van de HTTP-bron wordt gestart.</string>
      <string id="DelayCacheServerFallbackBackground">Terugvalvertraging achtergronddownload cacheserver (in seconden)</string>
      <string id="DelayCacheServerFallbackBackground_Help">Voor downloads op de achtergrond die een cacheserver gebruiken, geeft u de wachttijd op voordat u terugvalt om te downloaden vanaf de oorspronkelijke HTTP-bron.</string>
      <string id="DelayCacheServerFallbackForeground">Terugvalvertraging voorgronddownload cacheserver (in seconden)</string>
      <string id="DelayCacheServerFallbackForeground_Help">Voor downloads op de voorgrond die gebruikmaken van een cacheserver, geeft u de wachttijd op voordat u terugkeert naar het downloaden van de oorspronkelijke HTTP-bron.</string>
      <string id="RestrictPeerSelectionBy">Een methode selecteren om peerselectie te beperken</string>
      <string id="RestrictPeerSelectionBy_Help">Hiermee wordt opgegeven dat peerselectie moet worden beperkt met de geselecteerde methode, naast het DownloadMode-beleid.

0 = Geen
1 = Subnetmasker
2 = Lokale detectie (DNS-SD)</string>
      <string id="RestrictPeerSelectionBy_None">Geen</string>
      <string id="RestrictPeerSelectionBy_Subnet">Subnetmasker</string>
      <string id="RestrictPeerSelectionBy_LinkLocal">Lokale detectie (DNS-SD)</string>
      <string id="SetHoursToLimitBackgroundDownloadBandwidth">Kantooruren instellen om de bandbreedte voor downloaden op de achtergrond te beperken</string>
      <string id="SetHoursToLimitBackgroundDownloadBandwidth_Help">De maximale bandbreedte voor downloaden op de achtergrond die buiten en tijdens kantooruren door Delivery Optimization wordt gebruikt voor alle gelijktijdige downloadactiviteiten, als percentage van de beschikbare downloadbandbreedte. </string>
      <string id="SetHoursToLimitForegroundDownloadBandwidth">Kantooruren instellen om de bandbreedte voor downloaden op de voorgrond te beperken</string>
      <string id="SetHoursToLimitForegroundDownloadBandwidth_Help">De maximale bandbreedte voor downloaden op de voorgrond die buiten en tijdens kantooruren door Delivery Optimization wordt gebruikt voor alle gelijktijdige downloadactiviteiten, als percentage van de beschikbare downloadbandbreedte. </string>
      <string id="Time1AM">1:00 uur</string>
      <string id="Time1PM">13:00 uur</string>
      <string id="Time2AM">2:00 uur</string>
      <string id="Time2PM">14:00 uur</string>
      <string id="Time3AM">3:00 uur</string>
      <string id="Time3PM">15:00 uur</string>
      <string id="Time4AM">4:00 uur</string>
      <string id="Time4PM">16:00 uur</string>
      <string id="Time5AM">5:00 uur</string>
      <string id="Time5PM">17:00 uur</string>
      <string id="Time6AM">6:00 uur</string>
      <string id="Time6PM">18:00 uur</string>
      <string id="Time7AM">7:00 uur</string>
      <string id="Time7PM">19:00 uur</string>
      <string id="Time8AM">8:00 uur</string>
      <string id="Time8PM">20:00 uur</string>
      <string id="Time9AM">9:00 uur</string>
      <string id="Time9PM">21:00 uur</string>
      <string id="Time10AM">10:00 uur</string>
      <string id="Time10PM">22:00 uur</string>
      <string id="Time11AM">11:00 uur</string>
      <string id="Time11PM">23:00 uur</string>
      <string id="Time12AM">12:00 uur</string>
      <string id="Time12PM">00:00 uur</string>
      <string id="VpnKeywords">VPN-trefwoorden</string>
      <string id="VpnKeywords_Help">Hiermee geeft u een of meer trefwoorden op die worden gebruikt om VPN-verbindingen te herkennen. Als u meerdere trefwoorden wilt toevoegen, scheidt u deze door een komma.</string>
    </stringTable>
    <presentationTable>
      <presentation id="DownloadMode">
        <dropdownList defaultItem="1" noSort="true" refId="DownloadMode">Downloadmodus:</dropdownList>
      </presentation>
      <presentation id="GroupId">
        <textBox refId="GroupId">
          <label>Groeps-id:</label>
        </textBox>
      </presentation>
      <presentation id="MaxCacheSize">
        <decimalTextBox defaultValue="20" refId="MaxCacheSize">Maximale cachegrootte (percentage):</decimalTextBox>
      </presentation>
      <presentation id="AbsoluteMaxCacheSize">
        <decimalTextBox defaultValue="10" refId="AbsoluteMaxCacheSize">Absolute maximale cachegrootte (in GB):</decimalTextBox>
      </presentation>
      <presentation id="MaxCacheAge">
        <decimalTextBox defaultValue="604800" refId="MaxCacheAge">Maximale cacheleeftijd (in seconden):</decimalTextBox>
      </presentation>
      <presentation id="MonthlyUploadDataCap">
        <decimalTextBox defaultValue="5120" refId="MonthlyUploadDataCap">Maandelijkse gegevenslimiet voor uploaden (in GB):</decimalTextBox>
      </presentation>
      <presentation id="MinBackgroundQos">
        <decimalTextBox defaultValue="20480" refId="MinBackgroundQos">Minimumachtergrond QoS (in kB/s):</decimalTextBox>
      </presentation>
      <presentation id="ModifyCacheDrive">
        <textBox refId="ModifyCacheDrive">
          <label>Cachestation aanpassen:</label>
        </textBox>
      </presentation>
      <presentation id="MaxBackgroundDownloadBandwidth">
        <decimalTextBox defaultValue="0" refId="MaxBackgroundDownloadBandwidth">Maximale bandbreedte voor downloaden op achtergrond (in kB/s):</decimalTextBox>
      </presentation>
      <presentation id="MaxForegroundDownloadBandwidth">
        <decimalTextBox defaultValue="0" refId="MaxForegroundDownloadBandwidth">Maximale bandbreedte voor downloaden op de voorgrond (in kB/s):</decimalTextBox>
      </presentation>
      <presentation id="PercentageMaxBackgroundBandwidth">
        <decimalTextBox defaultValue="0" refId="PercentageMaxBackgroundBandwidth">Maximale bandbreedte voor downloaden op achtergrond (percentage):</decimalTextBox>
      </presentation>
      <presentation id="PercentageMaxForegroundBandwidth">
        <decimalTextBox defaultValue="0" refId="PercentageMaxForegroundBandwidth">Maximale bandbreedte voor downloaden op voorgrond (percentage):</decimalTextBox>
      </presentation>
      <presentation id="MinFileSizeToCache">
        <decimalTextBox defaultValue="100" refId="MinFileSizeToCache">Minimale bestandsgrootte voor inhoud van P2P-caching (in MB):</decimalTextBox>
      </presentation>
      <presentation id="AllowVPNPeerCaching">
        <checkBox defaultChecked="false" refId="AllowVPNPeerCaching">P2P inschakelen terwijl het apparaat verbinding maakt via VPN</checkBox>
      </presentation>
      <presentation id="MinRAMAllowedToPeer">
        <decimalTextBox defaultValue="4" refId="MinRAMAllowedToPeer">Minimaal vereiste RAM-capaciteit (inclusief) voor gebruik van P2P-caching (in GB)</decimalTextBox>
      </presentation>
      <presentation id="MinDiskSizeAllowedToPeer">
        <decimalTextBox defaultValue="32" refId="MinDiskSizeAllowedToPeer">Minimale schijfgrootte die P2P mag gebruiken (in GB):</decimalTextBox>
      </presentation>
      <presentation id="MinBatteryPercentageAllowedToUpload">
        <decimalTextBox defaultValue="0" refId="MinBatteryPercentageAllowedToUpload">Minimale batterijniveau (percentage):</decimalTextBox>
      </presentation>
      <presentation id="CacheHost">
        <textBox refId="CacheHost">
          <label>Cacheserver:</label>
        </textBox>
      </presentation>
      <presentation id="CacheHostSource">
        <dropdownList defaultItem="0" noSort="true" refId="CacheHostSource">Bron van hostnaam cacheserver:</dropdownList>
      </presentation>
      <presentation id="DisallowCacheServerDownloadsOnVPN">
        <checkBox defaultChecked="false" refId="DisallowCacheServerDownloadsOnVPN">Downloaden van MCC via VPN niet toestaan</checkBox>
      </presentation>
      <presentation id="GroupIdSource">
        <dropdownList defaultItem="0" noSort="true" refId="GroupIdSource">Bron van groeps-ID's:</dropdownList>
      </presentation>
      <presentation id="DelayBackgroundDownloadFromHttp">
        <decimalTextBox defaultValue="0" refId="DelayBackgroundDownloadFromHttp">Download op de achtergrond via HTTP vertragen (in seconden):</decimalTextBox>
      </presentation>
      <presentation id="DelayForegroundDownloadFromHttp">
        <decimalTextBox defaultValue="0" refId="DelayForegroundDownloadFromHttp">Download op de voorgrond via HTTP vertragen (in seconden):</decimalTextBox>
      </presentation>
      <presentation id="DelayCacheServerFallbackBackground">
        <decimalTextBox defaultValue="0" refId="DelayCacheServerFallbackBackground">Terugvalvertraging achtergronddownload cacheserver (in s):</decimalTextBox>
      </presentation>
      <presentation id="DelayCacheServerFallbackForeground">
        <decimalTextBox defaultValue="0" refId="DelayCacheServerFallbackForeground">Terugvalvertraging achtergronddownload cacheserver (in s):</decimalTextBox>
      </presentation>
      <presentation id="RestrictPeerSelectionBy">
        <dropdownList defaultItem="1" noSort="true" refId="RestrictPeerSelectionBy">Peerselectie beperken tot:</dropdownList>
      </presentation>
      <presentation id="VpnKeywords">
        <textBox refId="VpnKeywords">
          <label>VPN-trefwoorden:</label>
        </textBox>
      </presentation>
      <presentation id="SetHoursToLimitBackgroundDownloadBandwidth">
        <text/>
        <text>Kantooruren instellen om de bandbreedte voor downloaden op de achtergrond te beperken:</text>
        <dropdownList defaultItem="8" noSort="true" refId="SetHoursToLimitBackgroundDownloadBandwidthFrom">Van:</dropdownList>
        <dropdownList defaultItem="17" noSort="true" refId="SetHoursToLimitBackgroundDownloadBandwidthTo">Tot:</dropdownList>
        <text/>
        <text>Maximale bandbreedte voor downloaden op de achtergrond (percentage) tijdens kantooruren:</text>
        <decimalTextBox defaultValue="0" refId="SetHoursToLimitBackgroundDownloadBandwidthIn"/>
        <text/>
        <text>Maximale bandbreedte voor downloaden op de achtergrond (percentage) buiten kantooruren:</text>
        <decimalTextBox defaultValue="0" refId="SetHoursToLimitBackgroundDownloadBandwidthOut"/>
      </presentation>
      <presentation id="SetHoursToLimitForegroundDownloadBandwidth">
        <text/>
        <text>Kantooruren instellen om de bandbreedte voor downloaden op de voorgrond te beperken:</text>
        <dropdownList defaultItem="8" noSort="true" refId="SetHoursToLimitForegroundDownloadBandwidthFrom">Van:</dropdownList>
        <dropdownList defaultItem="17" noSort="true" refId="SetHoursToLimitForegroundDownloadBandwidthTo">Tot:</dropdownList>
        <text/>
        <text>Maximale bandbreedte voor downloaden op de voorgrond (percentage) tijdens kantooruren:</text>
        <decimalTextBox defaultValue="0" refId="SetHoursToLimitForegroundDownloadBandwidthIn"/>
        <text/>
        <text>Maximale bandbreedte voor downloaden op de voorgrond (percentage) buiten kantooruren:</text>
        <decimalTextBox defaultValue="0" refId="SetHoursToLimitForegroundDownloadBandwidthOut"/>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
