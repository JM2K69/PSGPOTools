        <dropdownList refId="TrustedSites" noSort="true" defaultItem="1">Vertrouwde websites</dropdownList>
        <dropdownList refId="Internet" noSort="true" defaultItem="1">Internet</dropdownList>
        <dropdownList refId="UntrustedSites" noSort="true" defaultItem="0">Niet-vertrouwde sites</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
