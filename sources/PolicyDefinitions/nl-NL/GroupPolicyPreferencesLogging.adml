    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Gebeurtenisregistratie</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Tracering</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
