  <displayName>Grupprincip för tangentbordsfilter</displayName>
  <description>Inställningar för grupprinciper för tangentbordsfilter</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Tangentbordsfilter</string>
      <string id="AllowKbFilterInRemoteSessions">Tillåt tangentbordsfilter i fjärrsessioner</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Tangentbordsfilter gäller vanligtvis bara för lokala sessioner.
      
Om du aktiverar den här inställningen tillämpas tangentbordsfiltret på användare som ansluter till datorn via fjärrsessioner.</string>
    </stringTable>
