<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Ρυθμίσεις NTLM</displayName>
  <description>Ρυθμίσεις παραμέτρων για το πακέτο ασφαλείας NTLM.</description>
  <resources>
    <stringTable>
      <string id="NTLM">NTLM</string>
      <string id="EnhancedAuditsId">Βελτιωμένη καταγραφή NTLM</string>
      <string id="EnhancedAuditsId_Explain">Αυτή η ρύθμιση πολιτικής επιτρέπει στο πακέτο ασφαλείας NTLM να καταγράφει τα νέα, βελτιωμένα αρχεία καταγραφής ελέγχου τόσο για υπολογιστές-πελάτες όσο και για διακομιστές.

      Αυτά τα βελτιωμένα αρχεία καταγραφής περιέχουν πληροφορίες σχετικά με το τι χρησιμοποιεί NTLM, γιατί χρησιμοποιείται το NTLM και τον προορισμό της αίτησης ελέγχου ταυτότητας NTLM. Επίσης, περιλαμβάνουν πληροφορίες για τη χρήση του NTLMv1 και άλλες υποβαθμίσεις ασφαλείας.

      Εάν έχετε ενεργοποιήσει ή δεν έχετε ρυθμίσει τις παραμέτρους αυτής της πολιτικής, θα δημιουργηθούν τα νέα αρχεία καταγραφής ελέγχου. Εάν απενεργοποιήσετε την πολιτική, τα νέα αρχεία καταγραφής δεν θα δημιουργηθούν.
      </string>
      <string id="EnhancedMachineBlockingWithAllowListId">Βελτιωμένος αποκλεισμός NTLM</string>
      <string id="EnhancedMachineBlockingWithAllowListId_Explained">Αυτή η ρύθμιση πολιτικής επιτρέπει στο πακέτο ασφαλείας NTLM να αποκλείει αιτήσεις ελέγχου ταυτότητας NTLM με βάση τις νέες, βελτιωμένες πολιτικές αποκλεισμού σε επίπεδο υπολογιστή.

      Αυτές οι βελτιωμένες πολιτικές αποκλεισμού σάς επιτρέπουν να αποκλείσετε τον έλεγχο ταυτότητας NTLM με βάση νέα κριτήρια, όπως ο τύπος του λογαριασμού, ο ρόλος της συσκευής ή ο τύπος της εφαρμογής.

      Αν η συνολική πολιτική έχει οριστεί σε "Απενεργοποιημένη" ή "Μη ρυθμισμένη", οι παρακάτω δευτερεύουσες ρυθμίσεις δεν θα τεθούν σε ισχύ. Αν η συνολική πολιτική έχει οριστεί σε "Ενεργοποιημένη", οι παρακάτω δευτερεύουσες πολιτικές θα τεθούν σε ισχύ με βάση τη διαμόρφωσή τους.

      Εκτός αν ρυθμιστούν οι παράμετροι, όλες οι πολιτικές έχουν οριστεί σε λειτουργία "Έλεγχος". Οι πολιτικές που έχουν οριστεί σε λειτουργία "Έλεγχος" θα καταγράφουν μια προειδοποίηση σχετικά με την αίτηση NTLM που θα μπορούσε να αποκλειστεί, αλλά δεν θα την αποκλείουν. Πολλαπλές πολιτικές που έχουν επισημανθεί ως "Έλεγχος" μπορούν να ενεργοποιηθούν ταυτόχρονα και θα καταγράφονται σε ένα ενιαίο αρχείο καταγραφής συμβάντων.

      Αν κάποια πολιτική έχει επισημανθεί ως "Ενεργοποιημένη", η αίτηση ελέγχου ταυτότητας NTLM θα αποκλειστεί αν πληροί τα κριτήρια της πολιτικής. Αν πολλές πολιτικές έχουν επισημανθεί ως "Ενεργοποιημένες", η αίτηση ελέγχου ταυτότητας NTLM θα αποκλειστεί εάν πληροί τα κριτήρια οποιασδήποτε από τις πολιτικές. Θα δημιουργηθεί ένα αρχείο καταγραφής συμβάντων για την πρώτη πολιτική που αποκλείει τον έλεγχο ταυτότητας NTLM. 

      Σε σενάρια όπου υπάρχουν πολιτικές τόσο "Έλεγχος" όσο και "Ενεργοποιημένη", η πολιτική "Ενεργοποιημένη" θα έχει προτεραιότητα.

      Όλες οι πολιτικές ενισχυμένου αποκλεισμού που περιγράφονται εδώ μοιράζονται την ίδια λίστα επιτρεπόμενων, η οποία καθορίζει τους λογαριασμούς, τις συσκευές και τις εφαρμογές που επιτρέπεται να χρησιμοποιούν έλεγχο ταυτότητας NTLM. Η λίστα αποδοχής μπορεί να περιέχει μια σειρά ονομάτων προορισμού ή SPN για να επιτραπεί ο έλεγχος ταυτότητας. 

      Για περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση aka.ms/ntlmlogandblock.
      </string>
      <string id="Disabled">Απενεργοποιημένη</string>
      <string id="Audit">Έλεγχος</string>
      <string id="Enabled">Ενεργοποιημένη</string>
    </stringTable>
    <presentationTable>
      <presentation id="EnhancedMachineBlockingWithAllowListId">
        <dropdownList refId="DomainSingleSignOnDropDown" defaultItem="0" noSort="true">Αποκλεισμός NTLM για λογαριασμούς τομέα με καθολική σύνδεση</dropdownList>
        <dropdownList refId="DomainControllerAuthDropDown" defaultItem="0" noSort="true">Αποκλεισμός NTLM για ελεγκτές τομέα</dropdownList>
        <dropdownList refId="MachineBindingDropDown" defaultItem="0" noSort="true">Αποκλεισμός NTLM όταν αποτυγχάνει η σύνδεση μηχανής</dropdownList>
        <dropdownList refId="BlockAllDropDown" defaultItem="0" noSort="true">Αποκλεισμός όλου του ελέγχου ταυτότητας NTLM</dropdownList>
        <multiTextBox refId="EnhancedMachineBlockingWithAllowListBox">Καθορίστε τη λίστα αποδοχής για βελτιωμένες πολιτικές αποκλεισμού:</multiTextBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
