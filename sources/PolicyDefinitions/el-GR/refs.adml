<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Πολιτική ομάδας ReFS</displayName>
  <description>Ρυθμίσεις πολιτικής ομάδας για ReFS</description>
  <resources>
    <stringTable>
      <string id="ReFS">ReFS</string>
      <string id="EnableDevDrive">Ενεργοποίηση μονάδας δίσκου ανάπτυξης</string>
      <string id="EnableDevDriveText">Η μονάδα δίσκου ανάπτυξης ή τόμος ανάπτυξης είναι ένας τόμος βελτιστοποιημένος για επιδόσεις σεναρίων προγραμματισμού. Ένας τόμος ανάπτυξης επιτρέπει σε ένα διαχειριστή να επιλέξει φίλτρα συστήματος αρχείων που είναι συνημμένα στον τόμο.

Η απενεργοποίηση αυτής της ρύθμισης θα απενεργοποιήσει τη δημιουργία τόμων ανάπτυξης, οι υπάρχοντες τόμοι ανάπτυξης θα μονταριστούν ως κανονικοί τόμοι.

Αν δεν ρυθμιστούν οι παράμετροι αυτής της ρύθμισης, η προεπιλεγμένη πολιτική είναι η ενεργοποίηση τόμων ανάπτυξης ενώ επιτρέπεται στο φίλτρο προστασίας από ιούς να επισυνάπτεται σε έναν τόμο ανάπτυξης.  Επιπλέον, εάν δεν ρυθμιστούν οι παράμετροι, ένας τοπικός διαχειριστής μπορεί να επιλέξει να μην έχει συνημμένο φίλτρο προστασίας από ιούς σε έναν τόμο ανάπτυξης.

Απαιτείται επανεκκίνηση για να τεθεί σε ισχύ αυτή η ρύθμιση.</string>
      <string id="ModeOff">Ανενεργό</string>
      <string id="ModeAudit">Μόνο έλεγχος</string>
      <string id="ModeBlock">Αποκλεισμός</string>
      <string id="BlockExternalBusMount">Έλεγχος μονταρίσματος τόμων ReFS σε δίσκους USB και IEEE 1394</string>
      <string id="BlockExternalBusMountText">Ελέγχει αν επιτρέπεται το μοντάρισμα τόμων ReFS σε δίσκους που είναι συνδεδεμένοι με USB ή IEEE 1394. Το ReFS δεν είναι μια υποστηριζόμενη ρύθμιση παραμέτρων σε hot-pluggable δίσκους ή σε αφαιρούμενους δίσκους.

Ο αποκλεισμός απορρίπτει το μοντάρισμα και καταγράφει ένα συμβάν στο αρχείο καταγραφής συστήματος.

Ο έλεγχος επιτρέπει μόνο το μοντάρισμα και καταγράφει το ίδιο συμβάν, επομένως, το αποτέλεσμα της ενεργοποίησης αυτής της πολιτικής μπορεί να αξιολογηθεί πριν από την επιβολή της.

Η απενεργοποίηση δεν εκτελεί έλεγχο και δεν υπάρχει αποκλεισμός.

Για έναν τόμο χώρων αποθήκευσης, ο έλεγχος ισχύει για τους φυσικούς δίσκους που υποστηρίζουν τον χώρο συγκέντρωσης και όχι για τον ίδιο τον χώρο.

Αν αυτή η ρύθμιση πολιτικής δεν έχει ρυθμιστεί, χρησιμοποιείται η τοπική ρύθμιση σε αυτόν τον υπολογιστή. Αν δεν υπάρχει τοπική ρύθμιση, χρησιμοποιείται η προεπιλεγμένη συμπεριφορά για αυτήν την έκδοση των Windows.

Το ReFS διαβάζει αυτήν τη ρύθμιση όταν φορτώνεται, επομένως απαιτείται επανεκκίνηση πριν από την εφαρμογή μιας αλλαγής. Η ρύθμιση αυτή αξιολογείται κάθε φορά που μοντάρεται ένας τόμος, επομένως, ένας τόμος που έχει ήδη μονταριστεί διατηρεί την τρέχουσα κατάστασή του έως ότου αποσυνδεθεί και μονταριστεί ξανά.</string>
      <string id="BlockHotplugMount">Έλεγχος μονταρίσματος τόμων ReFS σε δίσκους με δυνατότητα άμεσης σύνδεσης</string>
      <string id="BlockHotplugMountText">Ελέγχει αν επιτρέπεται το μοντάρισμα τόμων ReFS σε δίσκους που η στοίβα αποθήκευσης αναφέρει hot-pluggable δίσκους, ανεξάρτητα από το δίαυλο στον οποίο είναι συνδεδεμένοι. Το ReFS δεν είναι υποστηριζόμενη ρύθμιση παραμέτρων σε ενεργούς ή αφαιρούμενους δίσκους.

Ο αποκλεισμός απορρίπτει το μοντάρισμα και καταγράφει ένα συμβάν στο αρχείο καταγραφής συστήματος.

Ο έλεγχος επιτρέπει μόνο το μοντάρισμα και καταγράφει το ίδιο συμβάν, επομένως, το αποτέλεσμα της ενεργοποίησης αυτής της πολιτικής μπορεί να αξιολογηθεί πριν από την επιβολή της.

Η απενεργοποίηση δεν εκτελεί έλεγχο και δεν υπάρχει αποκλεισμός.

Για έναν τόμο χώρων αποθήκευσης, ο έλεγχος ισχύει για τους φυσικούς δίσκους που υποστηρίζουν τον χώρο συγκέντρωσης και όχι για τον ίδιο τον χώρο.

Αν αυτή η ρύθμιση πολιτικής δεν έχει ρυθμιστεί, χρησιμοποιείται η τοπική ρύθμιση σε αυτόν τον υπολογιστή. Αν δεν υπάρχει τοπική ρύθμιση, χρησιμοποιείται η προεπιλεγμένη συμπεριφορά για αυτήν την έκδοση των Windows.

Το ReFS διαβάζει αυτήν τη ρύθμιση όταν φορτώνεται, επομένως απαιτείται επανεκκίνηση πριν από την εφαρμογή μιας αλλαγής. Η ρύθμιση αυτή αξιολογείται κάθε φορά που μοντάρεται ένας τόμος, επομένως, ένας τόμος που έχει ήδη μονταριστεί διατηρεί την τρέχουσα κατάστασή του έως ότου αποσυνδεθεί και μονταριστεί ξανά.</string>
    </stringTable>

    <presentationTable>
      <presentation id="EnableDevDriveOptions">
        <checkBox refId="DevDriveAllowAntivirusFilter" defaultChecked="true">Να επιτρέπεται στο φίλτρο προστασίας από ιούς η προστασία μονάδων δίσκου ανάπτυξης</checkBox>
      </presentation>
      <presentation id="BlockExternalBusMountOptions">
        <dropdownList refId="BlockExternalBusMountMode" defaultItem="0">Ενέργεια για τόμους ReFS σε δίσκους USB ή IEEE 1394</dropdownList>
      </presentation>
      <presentation id="BlockHotplugMountOptions">
        <dropdownList refId="BlockHotplugMountMode" defaultItem="0">Ενέργεια για τόμους ReFS σε hot-pluggable δίσκους</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
