<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>πληκτρολογήστε εδώ το εμφανιζόμενο όνομα</displayName>
  <description>πληκτρολογήστε εδώ την περιγραφή</description>
  <resources>
    <stringTable>

      <string id="SecureBootCategory">Ασφαλής εκκίνηση</string>
      <string id="SecureBoot_MicrosoftUpdateManagedOptIn">Ανάπτυξη πιστοποιητικού μέσω ελεγχόμενης παράδοσης λογισμικού δυνατοτήτων</string>
      <string id="SecureBoot_MicrosoftUpdateManagedOptIn_Help">Για τις επιχειρήσεις που επιθυμούν βοήθεια για την ανάπτυξη των νέων πιστοποιητικών ασφαλούς εκκίνησης στις συσκευές τους, αυτή η ρύθμιση μπορεί να ενεργοποιηθεί.

 

Σημείωση: Η συσκευή πρέπει να στέλνει τα απαιτούμενα διαγνωστικά δεδομένα στη Microsoft για να χρησιμοποιήσει αυτήν τη δυνατότητα.

 

Για περισσότερες πληροφορίες, ανατρέξτε στο θέμα: https://aka.ms/GetSecureBoot </string>

      <string id="SecureBoot_HighConfidenceOptOut">Αυτόματη ανάπτυξη πιστοποιητικών μέσω ενημερώσεων</string>
      <string id="SecureBoot_HighConfidenceOptOut_Help">Για συσκευές όπου υπάρχουν διαθέσιμα αποτελέσματα δοκιμής που υποδεικνύουν ότι η συσκευή μπορεί να επεξεργαστεί τις ενημερώσεις πιστοποιητικών με επιτυχία, οι ενημερώσεις θα ξεκινήσουν αυτόματα ως μέρος των ενημερώσεων συντήρησης. Αυτή η πολιτική είναι ενεργοποιημένη από προεπιλογή. Για επιχειρήσεις που επιθυμούν τη διαχείριση της αυτόματης ενημέρωσης, χρησιμοποιήστε αυτήν την πολιτική για να ενεργοποιήσετε ή να απενεργοποιήσετε ρητά τη δυνατότητα.

 

Για περισσότερες πληροφορίες, ανατρέξτε στο θέμα: https://aka.ms/GetSecureBoot </string>

      <string id="SecureBoot_AvailableUpdatesPolicy">Ενεργοποίηση ανάπτυξης πιστοποιητικού ασφαλούς εκκίνησης</string>
      <string id="SecureBoot_AvailableUpdatesPolicy_Help">Αυτή η ρύθμιση πολιτικής σάς επιτρέπει να ενεργοποιήσετε ή να απενεργοποιήσετε τη διαδικασία ανάπτυξης πιστοποιητικών ασφαλούς εκκίνησης σε συσκευές. Όταν ενεργοποιηθούν, τα Windows θα ξεκινήσουν αυτόματα τη διαδικασία ανάπτυξης πιστοποιητικών σε συσκευές στις οποίες έχει εφαρμοστεί αυτή η πολιτική. 

 

Σημείωση: Αυτή η ρύθμιση μητρώου δεν είναι αποθηκευμένη σε κλειδί πολιτικής και αυτό θεωρείται προτίμηση. Επομένως, αν καταργηθεί ποτέ το αντικείμενο Πολιτική ομάδας που υλοποιεί αυτήν τη ρύθμιση, αυτή η ρύθμιση μητρώου θα παραμείνει. 

 

Σημείωση: Η εργασία των Windows που εκτελείται και επεξεργάζεται αυτήν τη ρύθμιση, εκτελείται κάθε 12 ώρες. Σε ορισμένες περιπτώσεις, οι ενημερώσεις θα διατηρούνται μέχρι να γίνει επανεκκίνηση του συστήματος για την ασφαλή ακολουθία των ενημερώσεων. 

 

Σημείωση: Αφού εφαρμοστούν τα πιστοποιητικά στο υλικολογισμικό, δεν μπορείτε να τα αναιρέσετε από τα Windows. Αν η εκκαθάριση των πιστοποιητικών είναι απαραίτητη, πρέπει να γίνει από τη διασύνδεση μενού υλικολογισμικού. 

 

Για περισσότερες πληροφορίες, ανατρέξτε στο θέμα: https://aka.ms/GetSecureBoot </string>

      <string id="LimitSecureBootRequiredServiceData">Περιορισμός απαιτούμενων δεδομένων υπηρεσίας ασφαλούς εκκίνησης</string>
      <string id="LimitSecureBootRequiredServiceData_Help">Αυτή η ρύθμιση πολιτικής ελέγχει εάν το λειτουργικό σύστημα εκπέμπει το καθημερινό συμβάν δεδομένων υπηρεσίας που απαιτείται για την Ασφαλή εκκίνηση. Το συμβάν περιέχει πληροφορίες σχετικά με τη διαμόρφωση ασφαλούς εκκίνησης της συσκευής και την κατάσταση της μεταβλητής υλικολογισμικού και συνήθως αποστέλλεται ανεξάρτητα από το επίπεδο διαγνωστικών δεδομένων Να επιτρέπεται η τηλεμετρία, επειδή ταξινομείται ως απαιτούμενο για λόγους ασφαλείας.

 

Ενεργοποιώντας αυτήν τη ρύθμιση πολιτικής, το καθημερινό συμβάν δεδομένων υπηρεσίας που απαιτείται για την Ασφαλή εκκίνηση δεν θα εκπέμπεται. Αυτό προορίζεται για επιχειρήσεις που λειτουργούν με βάση τη βασική γραμμή περιορισμένης λειτουργικότητας περιορισμένης κυκλοφορίας των Windows.

 

Αν απενεργοποιήσετε ή δεν ρυθμίσετε αυτήν τη ρύθμιση πολιτικής, το λειτουργικό σύστημα συνεχίζει να εκπέμπει το συμβάν δεδομένων υπηρεσίας που απαιτείται για την ασφαλή εκκίνηση σύμφωνα με τους υπάρχοντες κανόνες δικαιωμάτων τηλεμετρίας.</string>

      <string id="SUPPORTED_Windows8">Τουλάχιστον Windows Server 2012, Windows 8 ή Windows RT</string>  

    </stringTable>

  </resources>
</policyDefinitionResources>
