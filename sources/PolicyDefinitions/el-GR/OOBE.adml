<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Πολιτικές ομάδας OOBE</displayName>
  <description>Οι πολιτικές που ορίστηκαν για τη διαχείριση των ρυθμίσεων του OOBE μέσω των υπηρεσιών διαχείρισης πολιτικής ομάδας.</description>
  <resources>
    <stringTable>
      <string id="OOBECategory_DisplayName">OOBE</string>
      <string id="OOBECategory_Explain">Ρύθμιση συγκεκριμένων ρυθμίσεων που σχετίζονται με το OOBE</string>

      <string id="DisablePrivacyExperience">Να μην γίνει εκκίνηση της εμπειρίας ρυθμίσεων προστασίας προσωπικών δεδομένων κατά τη σύνδεση του χρήστη</string>
      <string id="DisablePrivacyExperience_Explain">Κατά τη σύνδεση σε έναν νέο λογαριασμό χρήστη για πρώτη φορά ή μετά από αναβάθμιση σε ορισμένες περιπτώσεις, στον χρήστη ενδέχεται να εμφανιστεί μια οθόνη ή μια σειρά οθονών που ζητούν από τον χρήστη να επιλέξει τις ρυθμίσεις προστασίας προσωπικών δεδομένων για τον λογαριασμό του. Ενεργοποιήστε αυτήν την πολιτική για να αποτρέψετε την εκκίνηση αυτής της εμπειρίας.

Αν αυτή η πολιτική είναι ενεργοποιημένη, η εμπειρία προστασίας προσωπικών δεδομένων δεν θα εκκινείται για τους νέους λογαριασμούς χρηστών ή για τους λογαριασμούς στους οποίους θα εμφανιζόταν η δυνατότητα επιλογής των ρυθμίσεων προστασίας προσωπικών δεδομένων μετά από αναβάθμιση.

Αν αυτή η πολιτική έχει απενεργοποιηθεί ή δεν έχουν ρυθμιστούν οι παράμετροι της, η εμπειρία προστασίας προσωπικών δεδομένων μπορεί να εκκινηθεί για τους νέους λογαριασμούς χρηστών ή για τους λογαριασμούς στους οποίους θα εμφανιζόταν η δυνατότητα επιλογής των ρυθμίσεων προστασίας προσωπικών δεδομένων μετά από αναβάθμιση.</string>

      <string id="AllowOOBEUpdates">Να επιτρέπονται οι ενημερώσεις στο OOBE</string>
      <string id="AllowOOBEUpdates_Explain">Αυτή η πολιτική σάς επιτρέπει να ρυθμίσετε αν μια νέα συσκευή λαμβάνει κρίσιμες ενημερώσεις κατά τη διάρκεια της εμπειρίας πρώτης χρήσης.

Αν απενεργοποιήσετε αυτήν την πολιτική ή δεν ρυθμίσετε τις παραμέτρους της, οι νέες συσκευές δεν θα λαμβάνουν κρίσιμες ενημερώσεις κατά τη διάρκεια της εμπειρίας πρώτης χρήσης.

Αν ενεργοποιήσετε την πολιτική, οι νέες συσκευές θα λαμβάνουν τις πιο πρόσφατες εγκεκριμένες κρίσιμες ενημερώσεις κατά τη διάρκεια της εμπειρίας πρώτης χρήσης.

Σημειώσεις:
Αυτή η πολιτική δεν ελέγχει τη σελίδα ενημερώσεων διορθωτικού προγράμματος ευπάθειας "ημέρας μηδέν" (ZDP) στο OOBE.

Αν έχετε θέσει σε παύση τις ενημερώσεις ποιότητας μέσω αναβολών ενημερώσεων ποιότητας των Windows και πολιτικών παύσης, δεν θα παραδίδονται ενημερώσεις ποιότητας κατά τη διάρκεια της εμπειρίας πρώτης χρήσης.
      </string>
    </stringTable>
  </resources>
</policyDefinitionResources>
