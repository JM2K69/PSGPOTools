        <checkBox refId="WindowsCalculator" defaultChecked="false">Windows Laskin</checkBox>
        <checkBox refId="WindowsCamera" defaultChecked="false">Windowsin kamera **</checkBox>
        <checkBox refId="MediaPlayer" defaultChecked="false">Windows Media Player **</checkBox>
