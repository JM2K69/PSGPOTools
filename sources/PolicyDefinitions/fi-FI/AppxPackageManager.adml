        <dropdownList refId="TrustedSites" noSort="true" defaultItem="1">Luotettavat sivustot</dropdownList>
        <dropdownList refId="Internet" noSort="true" defaultItem="1">Internet</dropdownList>
        <dropdownList refId="UntrustedSites" noSort="true" defaultItem="0">Ei-luotetut sivustot</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
