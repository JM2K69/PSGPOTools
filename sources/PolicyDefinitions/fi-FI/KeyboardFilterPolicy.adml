<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Näppäimistösuodatuksen ryhmäkäytäntö</displayName>
  <description>Näppäimistösuodatuksen ryhmäkäytäntöasetukset</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Näppäimistösuodatus</string>
      <string id="AllowKbFilterInRemoteSessions">Salli näppäimistösuodatus etäistunnoissa</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Näppäimistösuodatin koskee yleensä vain paikallisia istuntoja.
      
Tämän asetuksen ottaminen käyttöön mahdollistaa näppäimistösuodattimen käyttämisen käyttäjille, jotka muodostavat yhteyden tietokoneeseen etäistuntojen avulla.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
