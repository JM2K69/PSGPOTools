      <string id="CSE_NOCHANGES">Elabora anche se gli oggetti Criteri di gruppo non sono stati modificati</string>
      <string id="CSE_NOBACKGROUND">Non applicare durante l'elaborazione periodica in background</string>
      <string id="CSE_ALLOWSLOWLINK">Consenti elaborazione attraverso una connessione di rete lenta</string>
      <string id="CSE_TRACELEVEL">Traccia</string>
      <string id="CSE_TRACEFILEPATHUSER">Traccia utente</string>
      <string id="CSE_TRACEFILEPATHMACHINE">Traccia computer</string>
      <string id="CSE_TRACEFILEPATH">File di traccia</string>
      <string id="CSE_TRACEFILEPATHPLANNING">Traccia pianificazione</string>
      <string id="CSE_TRACEFILEMAXSIZE">Dimensione massima file di traccia (KB)</string>
      <string id="CSE_TRACELEVELNORMAL">Non attivo</string>
      <string id="CSE_TRACELEVELVERBOSE">Attivo</string>
      <string id="CSE_BACKGROUNDPRIORTYLEVEL">Priorità background</string>
      <string id="CSE_PRILEVEL_NORMAL">Normale</string>
      <string id="CSE_PRILEVEL_BELOWNORMAL">Inferiore al normale</string>
      <string id="CSE_PRILEVEL_LOWEST">Minima</string>
      <string id="CSE_PRILEVEL_IDLE">Inattiva</string>
      <string id="CSE_LOGLEVEL">Registrazione eventi</string>
      <string id="CSE_LOGLEVEL_INFORMATION">Informazioni, avvisi ed errori</string>
      <string id="CSE_LOGLEVEL_WARNINGS">Avvisi ed errori</string>
      <string id="CSE_LOGLEVEL_ERRORS">Solo errori</string>
      <string id="CSE_LOGLEVEL_NONE">Nessuno</string>
      <string id="CSE_Logging">Registrazione e traccia</string>
      <string id="CSE_Logging_Help">Consente di configurare le funzionalità di registrazione e traccia per i componenti Preferenze.</string>
    </stringTable>
    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Registrazione eventi</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Traccia</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>Traccia utente</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>Traccia computer</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Traccia pianificazione</label>
