        <dropdownList refId="SetMaximumStorageDuration_Text" noSort="true" defaultItem="0">Selezionare la durata di archiviazione massima:</dropdownList>
      </presentation>
      <presentation id="OnDeviceRegistryLoggingLevel">
        <dropdownList refId="OnDeviceRegistryLoggingLevel_Enum" noSort="true" defaultItem="0"> Livello di registrazione del registro di sistema sul dispositivo: </dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
