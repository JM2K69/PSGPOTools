        <textBox refId="SetCopilotHardwareKey_Name">
          <label>Immettere l'AUMID dell'app</label>
          <defaultValue>
          </defaultValue>
        </textBox>
      </presentation>
      <presentation id="SetDenyAppListForRecall">
