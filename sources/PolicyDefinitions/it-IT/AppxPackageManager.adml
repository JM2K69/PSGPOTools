        <dropdownList refId="TrustedSites" noSort="true" defaultItem="1">Siti attendibili</dropdownList>
        <dropdownList refId="Internet" noSort="true" defaultItem="1">Internet</dropdownList>
        <dropdownList refId="UntrustedSites" noSort="true" defaultItem="0">Siti non attendibili</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
