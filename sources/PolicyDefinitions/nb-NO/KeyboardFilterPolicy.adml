  <resources>
    <stringTable>
      <string id="KeyboardFilter">Tastaturfilter</string>
      <string id="AllowKbFilterInRemoteSessions">Tillat tastaturfilter i eksterne økter</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Tastaturfilter gjelder vanligvis bare for lokale økter.
      
