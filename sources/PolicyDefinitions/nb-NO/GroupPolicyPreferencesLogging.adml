    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Hendelseslogging</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Sporing</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>Brukersporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>Datasporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Planleggingssporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">Maksimal størrelse på sporingsfil (kB)</decimalTextBox>
      </presentation>
      <presentation id="CSE_DataSources_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Hendelseslogging</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Sporing</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>Brukersporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>Datasporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Planleggingssporing</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">Maksimal størrelse på sporingsfil (kB)</decimalTextBox>
      </presentation>
      <presentation id="CSE_Devices_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">Hendelseslogging</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">Sporing</dropdownList>
