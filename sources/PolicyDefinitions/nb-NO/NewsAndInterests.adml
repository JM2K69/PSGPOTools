<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>skriv inn visningsnavn her</displayName>
  <description>skriv inn beskrivelse her</description>
  <resources>
    <stringTable>
      <string id="NewsAndInterests">Miniprogrammer</string>
      <string id="AllowNewsAndInterests">Tillat kontrollprogrammer</string>
      <string id="Explain_AllowNewsAndInterests">Denne policyen angir om funksjonen for miniprogrammer er tillatt på enheten.
Miniprogrammer blir aktivert som standard med mindre du endrer dette i innstillingene.
Hvis du aktiverte denne funksjonen tidligere, vil den bli værende aktivert automatisk med mindre du deaktiverer den.</string>
      <string id="DisableWidgetsOnLockScreen">Deaktiver kontrollprogrammer på låseskjermen</string>
      <string id="Explain_DisableWidgetsOnLockScreen">Denne policyen angir om funksjonen for miniprogrammer skal deaktiveres på låseskjermen.
Hvis du deaktiverer eller ikke konfigurerer denne policyinnstillingen, vises kontrollprogrammer på låseskjermen og kan administreres i appen Windows-innstillinger.
Hvis du aktiverer denne policyinnstillingen, vises ikke miniprogrammer på låseskjermen.</string>
      <string id="DisableWidgetsBoard">Deaktiver miniprogramtavle</string>
      <string id="Explain_DisableWidgetsBoard">Denne policyen angir om tavleopplevelsen for miniprogram skal deaktiveres. 
Hvis du deaktiverer eller ikke konfigurerer denne policyinnstillingen, kan du aktivere kontrollprogramtavlen og se inngangspunktet på oppgavelinjen. Opplevelsen av kontrollprogramtavlen kan administreres i innstillinger for miniprogrammer som har et inngangspunkt på kontrollprogramtavlen.
Hvis du aktiverer denne policyinnstillingen, kan du ikke aktivere kontrollprogramtavlen, og inngangspunktet vil ikke lenger vises på oppgavelinjen.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
