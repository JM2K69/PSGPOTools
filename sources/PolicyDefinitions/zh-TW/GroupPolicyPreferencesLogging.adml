      <string id="CSE_NOCHANGES">即使群組原則物件尚未變更也進行處理</string>
      <string id="CSE_NOBACKGROUND">在定期的背景處理期間不要套用</string>
      <string id="CSE_ALLOWSLOWLINK">允許在低速網路連線之間處理</string>
      <string id="CSE_TRACELEVEL">追蹤</string>
      <string id="CSE_TRACEFILEPATHUSER">使用者追蹤</string>
      <string id="CSE_TRACEFILEPATHMACHINE">電腦追蹤</string>
      <string id="CSE_TRACEFILEPATH">追蹤檔</string>
      <string id="CSE_TRACEFILEPATHPLANNING">計劃追蹤</string>
      <string id="CSE_TRACEFILEMAXSIZE">追蹤檔案的最大容量 (KB)</string>
      <string id="CSE_TRACELEVELNORMAL">關閉</string>
      <string id="CSE_TRACELEVELVERBOSE">開啟</string>
      <string id="CSE_BACKGROUNDPRIORTYLEVEL">背景優先順序</string>
      <string id="CSE_PRILEVEL_NORMAL">標準</string>
      <string id="CSE_PRILEVEL_BELOWNORMAL">在標準以下</string>
      <string id="CSE_PRILEVEL_LOWEST">最低</string>
      <string id="CSE_PRILEVEL_IDLE">閒置</string>
      <string id="CSE_LOGLEVEL">事件記錄</string>
      <string id="CSE_LOGLEVEL_INFORMATION">資訊、警告和錯誤</string>
      <string id="CSE_LOGLEVEL_WARNINGS">警告和錯誤</string>
      <string id="CSE_LOGLEVEL_ERRORS">只限錯誤</string>
      <string id="CSE_LOGLEVEL_NONE">無</string>
      <string id="CSE_Logging">記錄和追蹤</string>
      <string id="CSE_Logging_Help">讓您設定喜好設定元件的記錄和追蹤。</string>
    </stringTable>
    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">事件記錄</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">追蹤</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>使用者追蹤</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>電腦追蹤</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>計劃追蹤</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">追蹤檔案的最大容量 (KB)</decimalTextBox>
      </presentation>
