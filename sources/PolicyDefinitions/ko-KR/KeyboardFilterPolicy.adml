<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>키보드 필터 그룹 정책</displayName>
  <description>키보드 필터에 대한 그룹 정책 설정</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">키보드 필터</string>
      <string id="AllowKbFilterInRemoteSessions">원격 세션에서 키보드 필터 허용</string>
      <string id="AllowKbFilterInRemoteSessions_Text">키보드 필터는 일반적으로 로컬 세션에만 적용됩니다.
      
이 설정을 사용하면 원격 세션을 통해 컴퓨터에 연결하는 사용자에게 키보드 필터를 적용할 수 있습니다.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
