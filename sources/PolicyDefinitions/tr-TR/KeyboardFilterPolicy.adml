  <displayName>Klavye Filtresi grup ilkesi</displayName>
  <description>Klavye Filtresi için grup ilkesi ayarları</description>
  <resources>
    <stringTable>
      <string id="KeyboardFilter">Klavye Filtresi</string>
      <string id="AllowKbFilterInRemoteSessions">Uzak oturumlarda Klavye Filtresine izin ver</string>
      <string id="AllowKbFilterInRemoteSessions_Text">Klavye filtresi genellikle yalnızca yerel oturumlar için geçerlidir.
      
Bu ayarın etkinleştirilmesi, klavye filtresinin bilgisayara uzak oturumlar tarafından bağlanan kullanıcılara uygulanmasını sağlar.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
