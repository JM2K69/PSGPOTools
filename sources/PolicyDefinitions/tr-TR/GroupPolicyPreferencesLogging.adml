        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>Planlama izleme</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">İzleme dosyası boyutu üst sınırı (KB)</decimalTextBox>
