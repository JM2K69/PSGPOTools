      <string id="CSE_NOCHANGES">グループ ポリシー オブジェクトが変更されていなくても処理する</string>
      <string id="CSE_NOBACKGROUND">バックグラウンドで定期的に処理しているときは適用しない</string>
      <string id="CSE_ALLOWSLOWLINK">低速回線接続からの処理を許可する</string>
      <string id="CSE_TRACELEVEL">トレース</string>
      <string id="CSE_TRACEFILEPATHUSER">ユーザー トレース</string>
      <string id="CSE_TRACEFILEPATHMACHINE">コンピューター トレース</string>
      <string id="CSE_TRACEFILEPATH">トレース ファイル</string>
      <string id="CSE_TRACEFILEPATHPLANNING">計画トレース</string>
      <string id="CSE_TRACEFILEMAXSIZE">トレース ファイルの最大サイズ (KB)</string>
      <string id="CSE_TRACELEVELNORMAL">オフ</string>
      <string id="CSE_TRACELEVELVERBOSE">オン</string>
      <string id="CSE_BACKGROUNDPRIORTYLEVEL">バックグラウンドの優先順位</string>
      <string id="CSE_PRILEVEL_NORMAL">標準</string>
      <string id="CSE_PRILEVEL_BELOWNORMAL">標準以下</string>
      <string id="CSE_PRILEVEL_LOWEST">最低</string>
      <string id="CSE_PRILEVEL_IDLE">アイドル</string>
      <string id="CSE_LOGLEVEL">イベント ログ</string>
      <string id="CSE_LOGLEVEL_INFORMATION">情報、警告およびエラー</string>
      <string id="CSE_LOGLEVEL_WARNINGS">警告およびエラー</string>
      <string id="CSE_LOGLEVEL_ERRORS">エラーのみ</string>
      <string id="CSE_LOGLEVEL_NONE">なし</string>
      <string id="CSE_Logging">ログおよびトレース</string>
      <string id="CSE_Logging_Help">基本設定コンポーネントのログおよびトレースを構成できます。</string>
    </stringTable>
    <presentationTable>
      <presentation id="CSE_Applications_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">イベント ログ</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">トレース</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
          <label>ユーザー トレース</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\User.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHMACHINE">
          <label>コンピューター トレース</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Computer.log</defaultValue>
        </textBox>
        <textBox refId="CSE_TRACEFILEPATHPLANNING">
          <label>計画トレース</label>
          <defaultValue>%COMMONAPPDATA%\GroupPolicy\Preference\Trace\Planning.log</defaultValue>
        </textBox>
        <decimalTextBox refId="CSE_TRACEFILEMAXSIZE" defaultValue="1024">トレース ファイルの最大サイズ (KB)</decimalTextBox>
      </presentation>
      <presentation id="CSE_DataSources_Logging">
        <dropdownList refId="CSE_LOGLEVEL" noSort="true" defaultItem="1">イベント ログ</dropdownList>
        <dropdownList refId="CSE_TRACELEVEL" noSort="true" defaultItem="1">トレース</dropdownList>
        <textBox refId="CSE_TRACEFILEPATHUSER">
