# Configuration of PSGPOTools, as shipped with the module.
#
# To change it, do not edit this file (an update of the module replaces it): the configuration
# of the domain holds the keys it changes, for every console of the domain, in the SYSVOL of its
# domain controllers: SYSVOL\<domain>\PSGPOTools\Configuration.psd1. Only the administrators
# of the domain can write it (the Settings window of the console, or the file itself); there is
# no configuration of the user. Get-PSGPOConfiguration shows where it is and the values in use.
# The files are read as data (Import-PowerShellDataFile): they run no code.
@{
    # A new GPO, created from the Group Policy Management view.
    NewGpo = @{
        # Name proposed for a new GPO.
        DefaultName = 'New Group Policy Object'

        # GPO status of a new GPO: Enabled, ComputerOnly (user settings disabled) or UserOnly
        # (computer settings disabled).
        Status = 'Enabled'

        # Security filtering groups: a group whose members alone apply the GPO, and a group whose
        # members never apply it.
        SecurityFilteringGroups = @{
            # "Create the security filtering groups" checked when the form opens.
            Create = $false

            # Where the groups are created: a distinguished name (OU=GPO,OU=Groups,DC=contoso,DC=com),
            # or a path below the domain (OU=GPO,OU=Groups). Empty: the users container (CN=Users).
            Container = ''

            # Names of the groups: the prefix, then the name of the GPO.
            ApplyPrefix = 'APPLY_'
            DenyPrefix = 'DENY_'

            # Scope of the security groups: Global, DomainLocal or Universal.
            Scope = 'Global'

            # Descriptions of the groups; {0} is the name of the GPO.
            ApplyDescription = 'Members apply the GPO {0}'
            DenyDescription = 'Members do not apply the GPO {0}'
        }
    }

    # Backups of the GPOs (History tab, Backup-PSGPO).
    Backup = @{
        # Label of the approved versions: the newest backup with it is the reference the GPO is
        # compared to, to find what changed since (Get-PSGPODrift, History tab).
        ApprovedLabel = 'Approved'

        # Label of the templates: a backup with it is proposed as the start of a new GPO (its
        # settings copied into it), whatever domain it comes from.
        TemplateLabel = 'Template'
    }
}
