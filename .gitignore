# Avalonia staged runtime binaries (downloaded via Get-AvaloniaBinaries.ps1)
HGPM/Avalonia/bin/

# Generated by CI/03_Build.ps1 from Code/ - never edit by hand
HGPM/HGPM.psm1

# Documentation: the built sites, and the screenshots copied from docs/assets into each language
site/
docs/en/assets/
docs/fr/assets/
# The Changelog pages, made from CHANGELOG.md when the site is built
docs/en/changelog.md
docs/fr/changelog.md

# The Security Compliance Toolkit of Microsoft, kept next to the repository: its files are not ours to publish
SCT/

# The ADMX files of Windows the tests read, and the package of Microsoft they come from
# (CI/Get-AdmxSource.ps1): its files are not ours to publish either
sources/
# Install-PSGPOAdmx run from the repository: next to the module
HGPM/sources/
